AI_RISK_APP_NAME=Digital Defense Hub AI Risk Engine
AI_RISK_APP_VERSION=1.0.0
AI_RISK_ENVIRONMENT=development

AI_RISK_HOST=127.0.0.1
AI_RISK_PORT=8091

# Must match backend-go AI_RISK_SERVICE_TOKEN.
# Generate a secure token with at least 32 characters.
AI_RISK_SERVICE_TOKEN=REPLACE_WITH_SECURE_SERVICE_TOKEN

AI_RISK_MODEL_NAME=DDH_INCIDENT_RANSOMWARE_RISK
AI_RISK_MODEL_VERSION=1.0.0
AI_RISK_POLICY_VERSION=2026.07

AI_RISK_MAXIMUM_REQUEST_BYTES=1048576

MEDIA_FORENSICS_MODEL_ROOT=models
MEDIA_FORENSICS_WORKSPACE_ROOT=storage/media-analysis

MEDIA_FORENSICS_TESSERACT_EXECUTABLE=tesseract
MEDIA_FORENSICS_FFMPEG_EXECUTABLE=ffmpeg

MEDIA_FORENSICS_MAXIMUM_FILE_BYTES=536870912
MEDIA_FORENSICS_ANALYSIS_TIMEOUT_SECONDS=300
MEDIA_FORENSICS_MAXIMUM_VIDEO_FRAMES=120
MEDIA_FORENSICS_VIDEO_FRAME_INTERVAL_SECONDS=1.0
MEDIA_FORENSICS_MAXIMUM_AUDIO_SECONDS=600
MEDIA_FORENSICS_MAXIMUM_DOCUMENT_PAGES=100

MEDIA_FORENSICS_OCR_LANGUAGES=eng
MEDIA_FORENSICS_TORCH_DEVICE=cpu
MEDIA_FORENSICS_ALLOW_HEURISTIC_FALLBACK=true

# Allows the AI engine to analyze files uploaded by backend-go.
MEDIA_FORENSICS_BACKEND_STORAGE_ROOT=../backend-go/storage/media-analysis

# Phase 1 model training: mounted ImageFolder datasets only.
ML_TRAINING_DATASET_ROOT=/datasets
ML_TRAINING_ARTIFACT_ROOT=models/trained
ML_TRAINING_MAXIMUM_EPOCHS=20
# Laptop-safe initial ceiling. Increase gradually after monitoring RAM/CPU.
ML_TRAINING_MAXIMUM_SAMPLES=4000
