APP_NAME=Digital Defense Hub
APP_FULL_NAME=Digital Defense Hub: Honey Token Based Ransomware Detection and Deepfake Verification
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cyber_security_platform
DB_SSLMODE=disable

JWT_SECRET=
JWT_EXPIRATION=24h

UPLOAD_PATH=./storage/uploads
MAX_UPLOAD_SIZE=104857600

CANARY_STORAGE_PATH=./storage/canary
CANARY_DEPLOYMENT_ROOT=./storage/canary-deployments


KEY_ENCRYPTION_MASTER_KEY=


LOG_LEVEL=debug
LOG_FILE=./storage/logs/application.log

