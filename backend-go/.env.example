APP_NAME=Digital Defense Hub
APP_FULL_NAME=Digital Defense Hub: Honey Token Based Ransomware Detection and Deepfake Verification
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cyber_security_platform
DB_SSLMODE=disable

JWT_SECRET=
JWT_EXPIRATION=24h

UPLOAD_PATH=./storage/uploads
MAX_UPLOAD_SIZE=104857600

CANARY_STORAGE_PATH=./storage/canary
CANARY_DEPLOYMENT_ROOT=./storage/canary-deployments


KEY_ENCRYPTION_MASTER_KEY=


LOG_LEVEL=debug
LOG_FILE=./storage/logs/application.log

# Notification Worker
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_COUNT=4
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_POLL_INTERVAL=2s
NOTIFICATION_DELIVERY_TIMEOUT=30s
NOTIFICATION_MAINTENANCE_INTERVAL=1m
NOTIFICATION_STALE_PROCESSING_PERIOD=5m

# Offline Local Desktop Notifications
NOTIFICATION_LOCAL_DESKTOP_ENABLED=true
NOTIFICATION_LOCAL_DESKTOP_OUTBOX_PATH=./storage/notification-outbox/local-desktop

# SMTP Email Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER_NAME=DDH_SMTP
NOTIFICATION_EMAIL_HOST=
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM_ADDRESS=
NOTIFICATION_EMAIL_FROM_NAME=Digital Defense Hub
NOTIFICATION_EMAIL_SUBJECT_PREFIX=[DDH]
NOTIFICATION_EMAIL_USE_IMPLICIT_TLS=false
NOTIFICATION_EMAIL_REQUIRE_STARTTLS=true
NOTIFICATION_EMAIL_TLS_INSECURE_SKIP_VERIFY=false
NOTIFICATION_EMAIL_TIMEOUT=30s

# HTTP SMS Gateway
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_SMS_PROVIDER_NAME=DDH_HTTP_SMS
NOTIFICATION_SMS_ENDPOINT_URL=
NOTIFICATION_SMS_API_KEY=
NOTIFICATION_SMS_API_KEY_HEADER=Authorization
NOTIFICATION_SMS_API_KEY_PREFIX=Bearer
NOTIFICATION_SMS_FROM_NUMBER=
NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE=+91
NOTIFICATION_SMS_ALLOW_INSECURE_HTTP=false
NOTIFICATION_SMS_TIMEOUT=20s

# Signed Webhook Notifications
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_PROVIDER_NAME=DDH_WEBHOOK
NOTIFICATION_WEBHOOK_ENDPOINT_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_SIGNATURE_HEADER=X-DDH-Signature
NOTIFICATION_WEBHOOK_TIMESTAMP_HEADER=X-DDH-Timestamp
NOTIFICATION_WEBHOOK_ALLOW_INSECURE_HTTP=false
NOTIFICATION_WEBHOOK_TIMEOUT=20s

# -------------------------------------------------------------
# Local Python AI Ransomware Risk Scoring Engine
# -------------------------------------------------------------

AI_RISK_ENABLED=true
AI_RISK_ENGINE_URL=http://127.0.0.1:8091
AI_RISK_SERVICE_TOKEN=CHANGE_ME_WITH_A_RANDOM_HEX_TOKEN
AI_RISK_ENGINE_TIMEOUT=15s
AI_RISK_DEFAULT_VALIDITY=24h