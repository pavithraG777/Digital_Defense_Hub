APP_NAME=Digital Defense Hub
APP_FULL_NAME=Digital Defense Hub: Honey Token Based Ransomware Detection and Deepfake Verification
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cyber_security_platform
DB_SSLMODE=disable

JWT_SECRET=
JWT_EXPIRATION=24h

UPLOAD_PATH=./storage/uploads
MAX_UPLOAD_SIZE=104857600

CANARY_STORAGE_PATH=./storage/canary
CANARY_DEPLOYMENT_ROOT=./storage/canary-deployments


KEY_ENCRYPTION_MASTER_KEY=


LOG_LEVEL=debug
LOG_FILE=./storage/logs/application.log

# Notification Worker
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_COUNT=4
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_POLL_INTERVAL=2s
NOTIFICATION_DELIVERY_TIMEOUT=30s
NOTIFICATION_MAINTENANCE_INTERVAL=1m
NOTIFICATION_STALE_PROCESSING_PERIOD=5m

# Offline Local Desktop Notifications
NOTIFICATION_LOCAL_DESKTOP_ENABLED=true
NOTIFICATION_LOCAL_DESKTOP_OUTBOX_PATH=./storage/notification-outbox/local-desktop

# SMTP Email Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER_NAME=DDH_SMTP
NOTIFICATION_EMAIL_HOST=
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM_ADDRESS=
NOTIFICATION_EMAIL_FROM_NAME=Digital Defense Hub
NOTIFICATION_EMAIL_SUBJECT_PREFIX=[DDH]
NOTIFICATION_EMAIL_USE_IMPLICIT_TLS=false
NOTIFICATION_EMAIL_REQUIRE_STARTTLS=true
NOTIFICATION_EMAIL_TLS_INSECURE_SKIP_VERIFY=false
NOTIFICATION_EMAIL_TIMEOUT=30s

# HTTP SMS Gateway
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_SMS_PROVIDER_NAME=DDH_HTTP_SMS
NOTIFICATION_SMS_ENDPOINT_URL=
NOTIFICATION_SMS_API_KEY=
NOTIFICATION_SMS_API_KEY_HEADER=Authorization
NOTIFICATION_SMS_API_KEY_PREFIX=Bearer
NOTIFICATION_SMS_FROM_NUMBER=
NOTIFICATION_SMS_DEFAULT_COUNTRY_CODE=+91
NOTIFICATION_SMS_ALLOW_INSECURE_HTTP=false
NOTIFICATION_SMS_TIMEOUT=20s

# Signed Webhook Notifications
NOTIFICATION_WEBHOOK_ENABLED=false
NOTIFICATION_WEBHOOK_PROVIDER_NAME=DDH_WEBHOOK
NOTIFICATION_WEBHOOK_ENDPOINT_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_WEBHOOK_SIGNATURE_HEADER=X-DDH-Signature
NOTIFICATION_WEBHOOK_TIMESTAMP_HEADER=X-DDH-Timestamp
NOTIFICATION_WEBHOOK_ALLOW_INSECURE_HTTP=false
NOTIFICATION_WEBHOOK_TIMEOUT=20s

# -------------------------------------------------------------
# Local Python AI Ransomware Risk Scoring Engine
# -------------------------------------------------------------

AI_RISK_ENABLED=true
AI_RISK_ENGINE_URL=http://127.0.0.1:8091
AI_RISK_SERVICE_TOKEN=CHANGE_ME_WITH_A_RANDOM_HEX_TOKEN
AI_RISK_ENGINE_TIMEOUT=15s
AI_RISK_DEFAULT_VALIDITY=24h

# ------------------------------------------------------------
# Pre-Encryption Ransomware Detection
# ------------------------------------------------------------

PRE_ENCRYPTION_ENABLED=true
PRE_ENCRYPTION_WINDOW_DURATION=1m
PRE_ENCRYPTION_MINIMUM_SCORE=25
PRE_ENCRYPTION_WORKER_COUNT=2
PRE_ENCRYPTION_QUEUE_CAPACITY=256
PRE_ENCRYPTION_ANALYSIS_TIMEOUT=30s

# Adaptive Deception Canary Health Monitoring
ADAPTIVE_DECEPTION_ENABLED=true
ADAPTIVE_DECEPTION_HEALTH_CHECK_INTERVAL=5m
ADAPTIVE_DECEPTION_WORKER_POLL_INTERVAL=1m
ADAPTIVE_DECEPTION_CHECK_TIMEOUT=30s
ADAPTIVE_DECEPTION_BATCH_SIZE=50

# Deepfake, Media Forensics and OCR
DEEPFAKE_FORENSICS_ENABLED=true

# Leave empty to reuse AI_RISK_ENGINE_URL and AI_RISK_SERVICE_TOKEN.
DEEPFAKE_FORENSICS_ENGINE_URL=
DEEPFAKE_FORENSICS_SERVICE_TOKEN=

DEEPFAKE_FORENSICS_ENGINE_TIMEOUT=2m
ML_TRAINING_TIMEOUT=12h
DEEPFAKE_FORENSICS_WORKER_COUNT=2
DEEPFAKE_FORENSICS_POLL_INTERVAL=1s
DEEPFAKE_FORENSICS_ANALYSIS_TIMEOUT=10m
DEEPFAKE_FORENSICS_PROCESSING_NODE=

DEEPFAKE_FORENSICS_STORAGE_PATH=./storage/media-analysis
DEEPFAKE_STORAGE_PROVIDER=filesystem
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_TLS=false
DEEPFAKE_MINIO_BUCKET=deepfake-media
EVIDENCE_MINIO_BUCKET=security-evidence
DEEPFAKE_FORENSICS_MAXIMUM_UPLOAD_BYTES=536870912

# Operational analysis connectors. Multiple Windows roots are separated with
# semicolons. Files outside these roots are rejected before scanner execution.
OPERATIONAL_CONNECTOR_ALLOWED_ROOTS=./storage/uploads;./storage/evidence-vault
# Full executable paths are recommended. If empty, PATH is checked for
# clamscan and vol respectively; missing tools fail jobs closed.
MALWARE_SCANNER_COMMAND=
MEMORY_FORENSICS_COMMAND=
# Authorized outbound integrations. Requests use POST JSON, an idempotency
# key, and this bearer token. Leave URLs empty to fail requests closed.
SIEM_WEBHOOK_URL=
TICKETING_WEBHOOK_URL=
INTEGRATION_CONNECTOR_TOKEN=


# Free, development-only MFA testing: OTPs are written to this local outbox.
# The frontend expects one six-digit email_code. Never enable this outside APP_ENV=development.
MFA_LOCAL_DELIVERY_ENABLED=true
MFA_LOCAL_OUTBOX_PATH=./storage/mfa-otp-outbox

# To send the same email OTP through Gmail SMTP, Brevo, or Resend SMTP,
# disable local delivery and fill the SMTP values above:
# MFA_LOCAL_DELIVERY_ENABLED=false
# NOTIFICATION_EMAIL_ENABLED=true
# NOTIFICATION_EMAIL_HOST=smtp.gmail.com
# NOTIFICATION_EMAIL_PORT=587
# NOTIFICATION_EMAIL_USERNAME=your-address@example.com
# NOTIFICATION_EMAIL_PASSWORD=your-app-password
# NOTIFICATION_EMAIL_FROM_ADDRESS=your-address@example.com
# SMS is not used by email-only MFA.
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false

# AWS SNS example (uncomment only after account activation and billing setup):
# NOTIFICATION_SMS_ENABLED=true
# NOTIFICATION_SMS_PROVIDER_NAME=AWS_SNS
# NOTIFICATION_SMS_AWS_REGION=ap-south-1
# NOTIFICATION_SMS_AWS_PROFILE=ddh-development
# NOTIFICATION_SMS_AWS_SENDER_ID=DDH
# NOTIFICATION_SMS_AWS_SMS_TYPE=Transactional
# Optional isolated command-analysis runner. Leave URL empty until the sandbox
# service is deployed. Never commit the real token.
COMMAND_SANDBOX_URL=
COMMAND_SANDBOX_TOKEN=
# Separate local runner settings (cmd/command-sandbox). The API host never
# executes submitted commands; this process invokes locked-down Docker only.
COMMAND_SANDBOX_LISTEN_ADDRESS=127.0.0.1:8091
COMMAND_SANDBOX_ARTIFACT_ROOT=./storage/command-artifacts
COMMAND_SANDBOX_DOCKER_EXECUTABLE=docker

# External recovery adapter. Leave empty until a controlled, authenticated
# runner is deployed; recovery actions are never executed by the API host.
RECOVERY_RUNNER_URL=
RECOVERY_RUNNER_TOKEN=
# Separate fail-closed college/demo runner. It validates and simulates approved
# actions; it never mutates the host endpoint or network.
RECOVERY_RUNNER_LISTEN_ADDRESS=127.0.0.1:8092
THREAT_INTEL_PROVIDER_URL=
THREAT_INTEL_PROVIDER_TOKEN=
# Used automatically when THREAT_INTEL_PROVIDER_URL is empty. Leave empty for
# built-in offline classification, or point to a curated local JSON feed.
THREAT_INTEL_LOCAL_FEED_PATH=

# Strong random bearer token used by Prometheus/monitoring collectors.
# When empty, /api/v1/metrics fails closed with HTTP 503.
METRICS_BEARER_TOKEN=

# Evidence manifest signing. Production should use a KMS/HSM adapter.
EVIDENCE_SIGNING_KEY_ID=
EVIDENCE_SIGNING_PRIVATE_KEY_BASE64=
EVIDENCE_SIGNING_PUBLIC_KEY_BASE64=
# JSON object of retired/current key IDs to base64 public keys for rotation.
EVIDENCE_VERIFY_KEYS_JSON={}
# Local/offline encrypted evidence object vault. The key must decode to exactly
# 32 bytes and must not be committed to source control.
EVIDENCE_VAULT_STORAGE_PATH=./storage/evidence-vault
EVIDENCE_VAULT_ENCRYPTION_KEY_ID=
EVIDENCE_VAULT_ENCRYPTION_KEY_BASE64=
EVIDENCE_VAULT_DECRYPT_KEYS_JSON={}
