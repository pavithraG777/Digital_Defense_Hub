# Deepfake/media storage security and operations.
# Append these settings to backend-go/.env.

# Existing plaintext assets remain compatible. To enable
# encryption, generate a key and set both values below.
DEEPFAKE_FORENSICS_STORAGE_ENCRYPTION_ENABLED=false
DEEPFAKE_FORENSICS_STORAGE_ENCRYPTION_KEY=

# Invalid extension/MIME/signature combinations are stored
# under the isolated _quarantine directory.
DEEPFAKE_FORENSICS_QUARANTINE_MALFORMED=true

# Non-destructive operations maintenance.
DEEPFAKE_FORENSICS_MAINTENANCE_INTERVAL=15m
DEEPFAKE_FORENSICS_STALE_PROCESSING_TIMEOUT=30m
DEEPFAKE_FORENSICS_TEMPORARY_FILE_TTL=1h

# Set 0 to disable automatic archiving. Archiving changes
# only database status; it never deletes source evidence.
DEEPFAKE_FORENSICS_RETENTION_DAYS=90
